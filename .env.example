# No secret values belong in this file or the downloadable package.
# Static preview has no required environment variables.
# Optional launcher port:
GF_PREVIEW_PORT=4175
# Hosted DB and BUCKET are platform bindings in .openai/hosting.json,
# not database-password strings. Owner identity is injected by the supported
# Sites proxy. Configure those through hosting settings, never client code.
# Payments and automated messaging are not configured in this review build.
